{%- for interface_name, interface in interfaces.items() %}
set / interface {{ interface_name }} admin-state {{ interface.admin_state }}
{%- if interface.ipv4 %}
set / interface {{ interface_name }} subinterface 0 ipv4 admin-state {{ interface.ipv4.admin_state }}
set / interface {{ interface_name }} subinterface 0 ipv4 address {{ interface.ipv4.address }}
{%- endif %}
{%- endfor %}

{%- for network_instance_name, network_instance in network_instances.items() %}
{%- for interface in network_instance.interfaces %}
set / network-instance {{ network_instance_name }} interface {{ interface }}
{%- endfor %}
{%- endfor %}

{%- if ospf %}
{%- set instance = ospf.instance %}
set / network-instance default protocols ospf instance {{ instance.name }} admin-state {{ instance.admin_state }}
set / network-instance default protocols ospf instance {{ instance.name }} version {{ instance.version }}
set / network-instance default protocols ospf instance {{ instance.name }} router-id {{ instance.router_id }}

{%- for area_id, area in instance.areas.items() %}
{%- for interface_name, interface in area.interfaces.items() %}
set / network-instance default protocols ospf instance {{ instance.name }} area {{ area_id }} interface {{ interface_name }}
{%- if interface.passive %}
set / network-instance default protocols ospf instance {{ instance.name }} area {{ area_id }} interface {{ interface_name }} passive true
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- if bgp %}
{{ '\n' }}set / network-instance default protocols bgp autonomous-system {{ bgp.autonomous_system }}
{{ '\n' }}set / network-instance default protocols bgp router-id {{ bgp.router_id }}
{{ '\n' }}set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state {{ bgp.afi_safi.ipv4_unicast.admin_state }}

{%- for group_name, group in bgp.peer_groups.items() %}
{{ '\n' }}set / network-instance default protocols bgp group {{ group_name }} peer-as {{ group.peer_as }}
{%- endfor %}

{%- for neighbor_address, neighbor in bgp.neighbors.items() %}
{{ '\n' }}set / network-instance default protocols bgp neighbor {{ neighbor_address }} peer-group {{ neighbor.peer_group }}
{%- endfor %}

{%- if routing_policies %}
{%- for prefix_set_name, prefix_set in routing_policies.prefix_sets.items() %}
{%- for entry in prefix_set.prefixes %}
{{ '\n' }}set / routing-policy prefix-set {{ prefix_set_name }} prefix {{ entry.prefix }} mask-length-range {{ entry.mask_length_range }}
{%- endfor %}
{%- endfor %}

{%- for policy_name, policy in routing_policies.policies.items() %}
{{ '\n' }}set / routing-policy policy {{ policy_name }} default-action policy-result {{ policy.default_action }}
{%- for statement in policy.statements %}
{{ '\n' }}set / routing-policy policy {{ policy_name }} statement {{ statement.sequence }} match prefix prefix-set {{ statement["match"]["prefix_set"] }} match-set-options {{ statement["match"]["match_set_options"] }}
{{ '\n' }}set / routing-policy policy {{ policy_name }} statement {{ statement.sequence }} action policy-result {{ statement.action }}
{%- endfor %}
{%- endfor %}
{%- endif %}

{%- if bgp.import_policy %}
{{ '\n' }}set / network-instance default protocols bgp import-policy [ {{ bgp.import_policy }} ]
{%- endif %}
{%- if bgp.export_policy %}
{{ '\n' }}set / network-instance default protocols bgp export-policy [ {{ bgp.export_policy }} ]
{%- endif %}
{%- endif %}
